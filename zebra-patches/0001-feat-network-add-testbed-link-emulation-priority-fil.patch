+/// FINDING: the reader task buffers far more unread data than the kernel would,
+/// removing TCP backpressure (memory per connection grows to the channel's size).
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn unread_data_is_buffered_in_userspace() {
+    async fn accepted_without_reading(wrapped: bool) -> usize {
+        let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+        let addr = listener.local_addr().expect("addr");
+        let mut client = TcpStream::connect(addr).await.expect("connect");
+        let (server, peer) = listener.accept().await.expect("accept");
+        let _hold: Box<dyn std::any::Any + Send> = if wrapped {
+            Box::new(wrap(server, peer))
+        } else {
+            Box::new(server)
+        };
+        let chunk = vec![0u8; 64 * 1024];
+        let mut sent = 0;
+        loop {
+            match tokio::time::timeout(Duration::from_millis(300), client.write(&chunk)).await {
+                Ok(Ok(n)) => sent += n,
+                _ => break,
+            }
+            if sent > 64 * 1024 * 1024 {
+                break;
+            }
+        }
+        sent
+    }
+    let plain = accepted_without_reading(false).await;
+    let shaped = accepted_without_reading(true).await;
+    println!("bytes accepted with nobody reading: plain {plain}, shaped {shaped}");
+    assert!(shaped > plain + 2 * 1024 * 1024, "expected extra userspace buffering");
+}
