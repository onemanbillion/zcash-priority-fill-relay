+/// Starts a timer for a block response. If the response is still running when even a slow
+/// honest peer would have finished it, the peer is demoted and the response gives up its
+/// upload slot, so a stalled reader can't hold back the next transfer.
+fn stall_watchdog(
+    tb: &Testbed,
+    peer: Option<IpAddr>,
+    bytes: u64,
+    est: f64,
+    started: Instant,
+) -> Option<(Arc<AtomicU8>, JoinHandle<()>)> {
+    let peer = peer?;
+    if bytes < MIN_SAMPLE_BYTES {
+        return None;
+    }
+    // `u64` to `f64` is exact below 2^53 bytes.
+    let limit = bytes as f64 / (DEMOTE_RATIO * est.min(tb.up.rate));
+    if !limit.is_finite() || limit <= 0.0 {
+        return None;
+    }
+    let limit = Duration::from_secs_f64(limit).max(scaled(UTIL_WINDOW));
+    let state = Arc::new(AtomicU8::new(SERVE_RUNNING));
+    let st = state.clone();
+    let handle = tokio::spawn(async move {
+        tokio::time::sleep(limit).await;
+        if st
+            .compare_exchange(
+                SERVE_RUNNING,
+                SERVE_RELEASED,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .is_err()
+        {
+            return;
+        }
+        let Some(tb) = TESTBED.get() else { return };
+        // `u64` to `f64` is exact below 2^53 bytes; this is an upper bound on the real rate.
+        let rate = bytes as f64 / started.elapsed().as_secs_f64().max(1e-9);
+        tb.demote(peer, rate);
+        {
+            let mut g = tb
+                .gate
+                .lock()
+                .expect("gate lock is never held across a panic");
+            g.active = g.active.saturating_sub(1);
+            tb.admit(&mut g, Instant::now());
+        }
+        log_event(&format!(
+            "STALL {peer} after={:.0}ms",
+            limit.as_secs_f64() * 1000.0
+        ));
+    });
+    Some((state, handle))
+}
