@@ -0,0 +1,469 @@
+//! Testbed-only stateless block relay built on Zebra's networking stack.
+//!
+//! It keeps no chain state and does no consensus validation. It uses zebra-network's real
+//! handshake, codec, peer set, block download routing and block advertiser, and mirrors
+//! zebrad's block gossip loop (including the 7 s PEER_GOSSIP_DELAY between broadcasts).
+//! Validation is modelled as a fixed delay before a downloaded block is relayed.
+
+use std::{
+    collections::{HashMap, HashSet},
+    net::{IpAddr, SocketAddr},
+    sync::{Arc, Mutex},
+    task::{Context, Poll},
+    time::{Duration, SystemTime, UNIX_EPOCH},
+};
+
+use futures::{future::BoxFuture, FutureExt};
+use tokio::sync::{mpsc, watch};
+use tower::{Service, ServiceExt};
+use zebra_chain::{
+    block::{self, Block},
+    chain_tip::NoChainTip,
+    parameters::Network,
+    serialization::ZcashDeserialize,
+};
+use zebra_network::{
+    testbed::{self, TestbedConfig},
+    BoxError, CacheDir, InventoryResponse, PeerSocketAddr, Request, Response,
+};
+
+
+struct Args {
+    id: usize,
+    ip: IpAddr,
+    port: u16,
+    peers: Vec<String>,
+    up: f64,
+    down: f64,
+    mode: String,
+    schedule: Option<String>,
+    log: String,
+    seed: u64,
+    validate_ms: u64,
+    target: usize,
+    lat_min: f64,
+    lat_max: f64,
+    duration_s: u64,
+    gossip_delay_ms: u64,
+    dl_timeout_s: u64,
+    time_scale: f64,
+    estimates: Option<String>,
+}
+
+fn parse_args() -> Args {
+    let mut m: HashMap<String, String> = HashMap::new();
+    let argv: Vec<String> = std::env::args().skip(1).collect();
+    for pair in argv.chunks(2) {
+        m.insert(
+            pair[0].trim_start_matches("--").to_string(),
+            pair.get(1).cloned().unwrap_or_default(),
+        );
+    }
+    let get = |k: &str| m.get(k).cloned().unwrap_or_else(|| panic!("missing --{k}"));
+    let opt = |k: &str, d: &str| m.get(k).cloned().unwrap_or_else(|| d.to_string());
+    Args {
+        id: get("id").parse().expect("id"),
+        ip: get("ip").parse().expect("ip"),
+        port: opt("port", "18344").parse().expect("port"),
+        peers: opt("peers", "")
+            .split(',')
+            .filter(|s| !s.is_empty())
+            .map(String::from)
+            .collect(),
+        up: get("up").parse().expect("up"),
+        down: get("down").parse().expect("down"),
+        mode: opt("mode", "zebra"),
+        schedule: m.get("schedule").cloned(),
+        log: get("log"),
+        seed: opt("seed", "1").parse().expect("seed"),
+        validate_ms: opt("validate-ms", "50").parse().expect("validate-ms"),
+        target: opt("target", "8").parse().expect("target"),
+        lat_min: opt("lat-min", "20").parse().expect("lat-min"),
+        lat_max: opt("lat-max", "150").parse().expect("lat-max"),
+        duration_s: opt("duration-s", "600").parse().expect("duration-s"),
+        gossip_delay_ms: opt("gossip-delay-ms", "7000").parse().expect("gossip-delay-ms"),
+        dl_timeout_s: opt("dl-timeout-s", "40").parse().expect("dl-timeout-s"),
+        time_scale: opt("time-scale", "1").parse().expect("time-scale"),
+        estimates: m.get("estimates").cloned(),
+    }
+}
+
+fn now_ms() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .expect("clock is after the epoch")
+        .as_millis()
+}
+
+// ---------------------------------------------------------------------------------------------
+// Synthetic full blocks
+
+fn compact(out: &mut Vec<u8>, n: u64) {
+    if n < 0xfd {
+        out.push(n as u8);
+    } else if n <= 0xffff {
+        out.push(0xfd);
+        out.extend_from_slice(&(n as u16).to_le_bytes());
+    } else {
+        out.push(0xfe);
+        out.extend_from_slice(&(n as u32).to_le_bytes());
+    }
+}
+
+struct Rng(u64);
+impl Rng {
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+    fn fill(&mut self, out: &mut Vec<u8>, n: usize) {
+        for _ in 0..n {
+            out.push(self.next() as u8);
+        }
+    }
+}
+
+/// Builds a full-size (about 1.95 MB) block of transparent v4 transactions.
+fn build_block(seed: u64, target_bytes: usize) -> Arc<Block> {
+    let mut rng = Rng(seed);
+    let mut txs: Vec<Vec<u8>> = Vec::new();
+    let mut total = 1487 + 5;
+    while total < target_bytes {
+        let mut tx = Vec::with_capacity(10_000);
+        tx.extend_from_slice(&0x8000_0004u32.to_le_bytes()); // overwintered, v4
+        tx.extend_from_slice(&0x892F_2085u32.to_le_bytes()); // sapling version group id
+        compact(&mut tx, 1); // one input
+        rng.fill(&mut tx, 32); // prevout txid
+        tx.extend_from_slice(&0u32.to_le_bytes());
+        compact(&mut tx, 107);
+        rng.fill(&mut tx, 107); // signature + pubkey sized script
+        tx.extend_from_slice(&0xffff_ffffu32.to_le_bytes());
+        // Two outputs with large scripts: realistic bytes on the wire, with few objects to
+        // parse, so 150 nodes sharing one machine's CPU don't distort timing.
+        compact(&mut tx, 2);
+        for _ in 0..2 {
+            tx.extend_from_slice(&1000i64.to_le_bytes());
+            compact(&mut tx, 4800);
+            rng.fill(&mut tx, 4800);
+        }
+        tx.extend_from_slice(&0u32.to_le_bytes()); // lock time
+        tx.extend_from_slice(&0u32.to_le_bytes()); // expiry height
+        tx.extend_from_slice(&0i64.to_le_bytes()); // sapling value balance
+        compact(&mut tx, 0); // spends
+        compact(&mut tx, 0); // outputs
+        compact(&mut tx, 0); // joinsplits
+        total += tx.len();
+        txs.push(tx);
+    }
+    let mut b = Vec::with_capacity(total + 16);
+    b.extend_from_slice(&4u32.to_le_bytes()); // version
+    rng.fill(&mut b, 32 * 3); // previous hash, merkle root, commitments
+    b.extend_from_slice(&(now_ms() as u64 / 1000).to_le_bytes()[..4]);
+    b.extend_from_slice(&0x1f07_ffffu32.to_le_bytes()); // difficulty bits
+    rng.fill(&mut b, 32); // nonce
+    compact(&mut b, 1344);
+    rng.fill(&mut b, 1344); // equihash solution (not checked by this relay)
+    compact(&mut b, txs.len() as u64);
+    for tx in &txs {
+        b.extend_from_slice(tx);
+    }
+    Arc::new(Block::zcash_deserialize(&b[..]).expect("synthetic block is well-formed"))
+}
+
+// ---------------------------------------------------------------------------------------------
+// Inbound service
+
+#[derive(Clone)]
+struct Inbound {
+    blocks: Arc<Mutex<HashMap<block::Hash, Arc<Block>>>>,
+    downloads: mpsc::UnboundedSender<(block::Hash, Option<PeerSocketAddr>)>,
+}
+
+impl Service<Request> for Inbound {
+    type Response = Response;
+    type Error = BoxError;
+    type Future = BoxFuture<'static, Result<Response, BoxError>>;
+
+    fn poll_ready(&mut self, _: &mut Context<'_>) -> Poll<Result<(), BoxError>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn call(&mut self, req: Request) -> Self::Future {
+        let rsp = match req {
+            Request::AdvertiseBlock(hash, advertiser) => {
+                let _ = self.downloads.send((hash, advertiser));
+                Response::Nil
+            }
+            Request::BlocksByHash(hashes) => {
+                let blocks = self.blocks.lock().expect("lock is not poisoned");
+                Response::Blocks(
+                    hashes
+                        .into_iter()
+                        .map(|h| match blocks.get(&h) {
+                            Some(b) => InventoryResponse::Available((b.clone(), None)),
+                            None => InventoryResponse::Missing(h),
+                        })
+                        .collect(),
+                )
+            }
+            Request::Peers => Response::Peers(Vec::new()),
+            Request::MempoolTransactionIds => Response::TransactionIds(Vec::new()),
+            _ => Response::Nil,
+        };
+        async move { Ok(rsp) }.boxed()
+    }
+}
+
+#[tokio::main(flavor = "multi_thread", worker_threads = 2)]
+async fn main() {
+    let a = parse_args();
+    if std::env::var("RUST_LOG").is_ok() {
+        tracing_subscriber::fmt()
+            .with_env_filter(tracing_subscriber::EnvFilter::from_default_env())
+            .with_writer(std::io::stderr)
+            .init();
+    }
+    let (priority, all) = match a.mode.as_str() {
+        "zebra" => (false, false),
+        "prio" => (true, true),
+        "prio_third" => (true, false),
+        "all_fair" => (false, true),
+        m => panic!("unknown mode {m}"),
+    };
+    testbed::install(TestbedConfig {
+        own_ip: a.ip,
+        upload_mbps: a.up,
+        download_mbps: a.down,
+        latency_seed: a.seed,
+        latency_min_ms: a.lat_min,
+        latency_max_ms: a.lat_max,
+        priority_upload: priority,
+        advertise_to_all: all,
+        log_path: Some(a.log.clone()),
+        time_scale: a.time_scale,
+    });
+    if let Some(path) = &a.estimates {
+        let text = std::fs::read_to_string(path).expect("estimates file is readable");
+        for line in text.lines() {
+            let f: Vec<&str> = line.split_whitespace().collect();
+            if let [ip, mbps] = f.as_slice() {
+                testbed::seed_peer_rate(ip.parse().expect("ip"), mbps.parse().expect("mbps"));
+            }
+        }
+    }
+    testbed::log_event(&format!(
+        "START id={} ip={} up={} down={} mode={}",
+        a.id, a.ip, a.up, a.down, a.mode
+    ));
+
+    let mut config = zebra_network::Config {
+        network: Network::new_regtest(Default::default()),
+        listen_addr: SocketAddr::new(a.ip, a.port),
+        cache_dir: CacheDir::disabled(),
+        peerset_initial_target_size: a.target.max(1),
+        ..Default::default()
+    };
+    config.initial_testnet_peers = a.peers.iter().cloned().collect();
+
+    let blocks: Arc<Mutex<HashMap<block::Hash, Arc<Block>>>> = Default::default();
+    let (dl_tx, mut dl_rx) = mpsc::unbounded_channel();
+    let inbound = Inbound {
+        blocks: blocks.clone(),
+        downloads: dl_tx,
+    };
+    let (peer_set, address_book, _misbehavior, mut advertiser) = zebra_network::init(
+        config,
+        inbound,
+        NoChainTip,
+        format!("/zebra-relay:{}/", a.id),
+    )
+    .await;
+
+    let (tip_tx, mut tip_rx) = watch::channel(None::<block::Hash>);
+    let (mined_tx, mut mined_rx) = mpsc::unbounded_channel::<block::Hash>();
+
+    // Gossiped block downloader: one in-flight download per hash, like zebrad's inbound downloads.
+    {
+        let blocks = blocks.clone();
+        let validate = Duration::from_millis(a.validate_ms);
+        let dl_timeout = Duration::from_secs(a.dl_timeout_s);
+        tokio::spawn(async move {
+            let inflight: Arc<Mutex<HashSet<block::Hash>>> = Default::default();
+            while let Some((hash, advertiser)) = dl_rx.recv().await {
+                if blocks.lock().expect("lock").contains_key(&hash)
+                    || !inflight.lock().expect("lock").insert(hash)
+                {
+                    continue;
+                }
+                let adv = advertiser.map(|x| x.to_string()).unwrap_or_default();
+                testbed::log_event(&format!("INV {hash} {adv}"));
+                let peer_set = peer_set.clone();
+                let blocks = blocks.clone();
+                let inflight = inflight.clone();
+                let tip_tx = tip_tx.clone();
+                tokio::spawn(async move {
+                    let res = tokio::time::timeout(
+                        dl_timeout,
+                        peer_set.oneshot(Request::BlockDownload { hash, advertiser }),
+                    )
+                    .await;
+                    match res {
+                        Ok(Ok(Response::Blocks(mut v))) if !v.is_empty() => {
+                            if let InventoryResponse::Available((block, from)) = v.remove(0) {
+                                let from = from.map(|x| x.to_string()).unwrap_or_default();
+                                testbed::log_event(&format!("RECV {hash} {from}"));
+                                tokio::time::sleep(validate).await;
+                                {
+                                    // Keep memory flat: only recent blocks are ever requested.
+                                    let mut b = blocks.lock().expect("lock");
+                                    if b.len() >= 4 {
+                                        b.clear();
+                                    }
+                                    b.insert(hash, block);
+                                }
+                                testbed::log_event(&format!("VALID {hash}"));
+                                let _ = tip_tx.send(Some(hash));
+                            } else {
+                                testbed::log_event(&format!("DLFAIL {hash} notfound"));
+                            }
+                        }
+                        other => {
+                            let why = match other {
+                                Ok(Ok(_)) => "unexpected response".to_string(),
+                                Ok(Err(e)) => e.to_string(),
+                                Err(_) => "timeout".to_string(),
+                            };
+                            testbed::log_event(&format!(
+                                "DLFAIL {hash} {}",
+                                why.replace(' ', "_")
+                            ));
+                        }
+                    }
+                    inflight.lock().expect("lock").remove(&hash);
+                });
+            }
+        });
+    }
+
+    // Block gossip, mirroring zebrad's gossip_best_tip_block_hashes loop.
+    let gossip_delay = Duration::from_millis(a.gossip_delay_ms);
+    tokio::spawn(async move {
+        loop {
+            let tip_change = async {
+                tokio::time::sleep(gossip_delay).await;
+                loop {
+                    if tip_rx.changed().await.is_err() {
+                        futures::future::pending::<()>().await;
+                    }
+                    if let Some(h) = *tip_rx.borrow_and_update() {
+                        return h;
+                    }
+                }
+            };
+            let (hash, mined) = tokio::select! {
+                h = tip_change => (h, false),
+                Some(h) = mined_rx.recv() => (h, true),
+            };
+            let req = if mined {
+                Request::AdvertiseBlockToAll(hash)
+            } else {
+                Request::AdvertiseBlock(hash, None)
+            };
+            match advertiser.ready().await {
+                Ok(svc) => {
+                    testbed::log_event(&format!("ADV {hash} mined={mined}"));
+                    let fut = svc.call(req);
+                    tokio::spawn(async move {
+                        if let Err(e) = fut.await {
+                            testbed::log_event(&format!(
+                                "ADVFAIL {hash} {}",
+                                e.to_string().replace(' ', "_")
+                            ));
+                        }
+                    });
+                }
+                Err(e) => testbed::log_event(&format!("ADVNOTREADY {e}")),
+            }
+        }
+    });
+
+    // Mining schedule: lines of "<unix_ms> <node_id> <seed>".
+    if let Some(path) = &a.schedule {
+        let text = std::fs::read_to_string(path).expect("schedule is readable");
+        for line in text.lines() {
+            let f: Vec<&str> = line.split_whitespace().collect();
+            if f.len() < 3 || f[1].parse::<usize>().ok() != Some(a.id) {
+                continue;
+            }
+            let at: u128 = f[0].parse().expect("time");
+            let seed: u64 = f[2].parse().expect("seed");
+            let blocks = blocks.clone();
+            let mined_tx = mined_tx.clone();
+            tokio::spawn(async move {
+                // Build the block a moment early so construction time isn't counted.
+                let lead = 1500u128;
+                let wait = at.saturating_sub(now_ms() + lead);
+                tokio::time::sleep(Duration::from_millis(wait as u64)).await;
+                let block = tokio::task::spawn_blocking(move || build_block(seed, 1_950_000))
+                    .await
+                    .expect("block builder does not panic");
+                let wait = at.saturating_sub(now_ms());
+                tokio::time::sleep(Duration::from_millis(wait as u64)).await;
+                let hash = block.hash();
+                blocks.lock().expect("lock").insert(hash, block);
+                testbed::log_event(&format!("MINED {hash}"));
+                let _ = mined_tx.send(hash);
+            });
+        }
+    }
+
+    // Periodically record connected peers and rate estimates.
+    let address_metrics = address_book
+        .lock()
+        .expect("lock is not poisoned")
+        .address_metrics_watcher();
+    tokio::spawn(async move {
+        loop {
+            tokio::time::sleep(Duration::from_secs(10)).await;
+            let est: Vec<String> = testbed::peer_rate_estimates()
+                .into_iter()
+                .map(|(ip, r)| format!("{ip}={r:.0}"))
+                .collect();
+            let responded = address_metrics.borrow().responded;
+            testbed::log_event(&format!("PEERS {responded}"));
+            testbed::log_event(&format!("ESTIMATES {}", est.join(",")));
+        }
+    });
+
+    // Event-loop lag monitor: how late a 100 ms timer fires. Large lag means the machine,
+    // not the emulated network, is the bottleneck.
+    tokio::spawn(async move {
+        let mut worst = Duration::ZERO;
+        let mut last_report = tokio::time::Instant::now();
+        loop {
+            let t = tokio::time::Instant::now();
+            tokio::time::sleep(Duration::from_millis(100)).await;
+            worst = worst.max(t.elapsed().saturating_sub(Duration::from_millis(100)));
+            if last_report.elapsed() >= Duration::from_secs(5) {
+                testbed::log_event(&format!("LAG {}", worst.as_millis()));
+                worst = Duration::ZERO;
+                last_report = tokio::time::Instant::now();
+            }
+        }
+    });
+
+    tokio::time::sleep(Duration::from_secs(a.duration_s)).await;
+    let stat = std::fs::read_to_string("/proc/self/stat").unwrap_or_default();
+    let f: Vec<&str> = stat.rsplit(')').next().unwrap_or("").split_whitespace().collect();
+    let ticks = |i: usize| f.get(i).and_then(|x| x.parse::<f64>().ok()).unwrap_or(0.0) / 100.0;
+    testbed::log_event(&format!("CPU {:.2} {:.2}", ticks(11), ticks(12)));
+    let status = std::fs::read_to_string("/proc/self/status").unwrap_or_default();
+    if let Some(l) = status.lines().find(|l| l.starts_with("VmHWM")) {
+        testbed::log_event(&format!("MEM {}", l.split_whitespace().nth(1).unwrap_or("0")));
+    }
+    testbed::log_event("STOP");
+    std::process::exit(0);
+}
-- 
2.43.0

