+    /// Records how fast a block response to `peer` was actually sent. A response far slower
+    /// than the estimate it was ranked by demotes the peer; a normal one lifts any demotion.
+    fn note_send(&self, peer: IpAddr, est: f64, rate: f64) -> bool {
+        if !rate.is_finite() || rate <= 0.0 || !est.is_finite() {
+            return false;
+        }
+        let mut caps = self
+            .send_caps
+            .lock()
+            .expect("send-cap lock is never held across a panic");
+        // The response can't go faster than this node's own upload, so judge it against that too.
+        if rate < DEMOTE_RATIO * est.min(self.up.rate) {
+            drop(caps);
+            self.demote(peer, rate);
+            true
+        } else {
+            caps.remove(&peer);
+            false
+        }
+    }
+
+    /// Caps `peer`'s rank at `rate`, the rate it actually read a block response at.
+    fn demote(&self, peer: IpAddr, rate: f64) {
+        let now = Instant::now();
+        let mut caps = self
+            .send_caps
+            .lock()
+            .expect("send-cap lock is never held across a panic");
+        let ttl = scaled(ESTIMATE_TTL);
+        caps.retain(|_, (_, at)| now.saturating_duration_since(*at) <= ttl);
+        if caps.len() >= MAX_ESTIMATES && !caps.contains_key(&peer) {
+            if let Some(oldest) = caps
+                .iter()
+                .min_by_key(|(_, (_, at))| *at)
+                .map(|(ip, _)| *ip)
+            {
+                caps.remove(&oldest);
+            }
+        }
+        caps.insert(peer, (rate, now));
+    }
