+        // If the watchdog already released this response's slot, don't release it twice.
+        let released = self.state.as_ref().is_some_and(|s| {
+            s.compare_exchange(
+                SERVE_RUNNING,
+                SERVE_FINISHED,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            )
+            .is_err()
