+        }
+        let label = self.peer.map(|p| p.to_string()).unwrap_or_default();
+        let secs = self.started.elapsed().as_secs_f64();
+        // Only priority-fill responses large enough to time are judged.
+        if let (Some(tb), Some(peer)) = (TESTBED.get(), self.peer) {
+            if tb.cfg.priority_upload && self.bytes >= MIN_SAMPLE_BYTES && secs > 0.0 {
