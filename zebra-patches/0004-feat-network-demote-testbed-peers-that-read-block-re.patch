+/// A response still running when even a slow honest reader would have finished gives up its
+/// upload slot, so the next transfer can start at once, and the stalled peer is demoted.
+#[tokio::test(flavor = "current_thread")]
+async fn stalled_response_releases_slot() {
+    install(cfg(true)); // 100 Mb/s upload
+    let (staller, next) = (ip("10.0.1.5"), ip("10.0.1.6"));
+    seed_peer_rate(staller, 400.0).expect("valid");
+    seed_peer_rate(next, 50.0).expect("valid");
+    // 2 MB at a quarter of 100 Mb/s takes 0.64 s: the watchdog fires then.
+    let stalled = serve_blocks(Some(staller), vec![hash(1)], 2_000_000)
+        .await
+        .expect("admitted");
+    tokio::time::sleep(Duration::from_millis(300)).await;
+    assert_eq!(active_slots(), 1, "the response holds its slot while it may be honest");
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    assert_eq!(active_slots(), 0, "the stalled response should give up its slot");
+    let est = TESTBED.get().expect("installed").rate_estimate(Some(staller)) * 8.0 / 1e6;
+    assert!(est < 30.0, "staller should be demoted, estimate {est}");
+
+    let next_guard = tokio::time::timeout(
+        Duration::from_millis(20),
+        serve_blocks(Some(next), vec![hash(1)], 2_000_000),
+    )
+    .await
+    .expect("admitted at once, with no slot busy")
+    .expect("admitted");
+    assert_eq!(active_slots(), 1);
+    drop(stalled);
+    assert_eq!(active_slots(), 1, "the released slot must not be released twice");
+    drop(next_guard);
+    assert_eq!(active_slots(), 0);
+}
