+    tokio::time::sleep(Duration::from_millis(100)).await;
+    let est = TESTBED.get().expect("installed").peer_rates.lock().expect("lock").get(&peer_ip).copied();
+    println!("estimate after 600 KiB of junk: {:?} Mb/s", est.map(|r| r * 8.0 / 1e6));
+    assert!(est.is_some(), "junk data created a throughput estimate");
+    drop(client);
+    let _ = drain.await;
+}
+
+/// FINDING: strict priority with no aging lets a high-ranked peer that keeps re-requesting
+/// starve a low-ranked peer indefinitely while the uplink stays busy.
+#[tokio::test(flavor = "current_thread")]
+async fn high_ranked_requester_can_starve_others() {
+    install(cfg(true));
+    let attacker: IpAddr = "10.0.0.66".parse().expect("ip");
+    let victim: IpAddr = "10.0.0.5".parse().expect("ip");
+    seed_peer_rate(attacker, 1000.0);
+    seed_peer_rate(victim, 10.0);
+    let tb = TESTBED.get().expect("installed");
+
+    // Two attacker request streams, so one is always queued when the other finishes.
+    let stop = Arc::new(std::sync::atomic::AtomicBool::new(false));
+    let mut attackers = Vec::new();
+    for _ in 0..2 {
+        let stop = stop.clone();
+        attackers.push(tokio::spawn(async move {
+            while !stop.load(Ordering::Relaxed) {
+                let g = serve_blocks(Some(attacker)).await;
+                // a fast transfer that keeps the uplink saturated (100 Mb/s for 20 ms)
+                tb.up.total.fetch_add(250_000, Ordering::Relaxed);
+                tokio::time::sleep(Duration::from_millis(20)).await;
+                drop(g);
+            }
+        }));
+    }
+    tokio::time::sleep(Duration::from_millis(30)).await;
+    let start = Instant::now();
+    let victim_wait = tokio::time::timeout(Duration::from_secs(2), serve_blocks(Some(victim))).await;
+    stop.store(true, Ordering::Relaxed);
+    for a in attackers {
+        let _ = a.await;
+    }
+    println!(
+        "victim admitted: {}, waited {:?}",
+        victim_wait.is_ok(),
+        start.elapsed()
+    );
+    assert!(victim_wait.is_err(), "expected the victim to be starved for 2 s");
+}
