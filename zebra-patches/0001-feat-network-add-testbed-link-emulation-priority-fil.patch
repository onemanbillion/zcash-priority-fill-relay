+//! Tests for the testbed link emulation and upload scheduler.
+//!
+//! Each test installs (or deliberately does not install) the process-global testbed,
+//! so these must run one test per process (`cargo nextest`).
+
+#![allow(clippy::print_stdout)]
+
+use std::{net::Ipv4Addr, time::Duration};
+
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream},
+};
+
+use super::*;
+
+fn cfg(priority: bool) -> TestbedConfig {
+    TestbedConfig {
+        own_ip: IpAddr::V4(Ipv4Addr::LOCALHOST),
+        upload_mbps: 100.0,
+        download_mbps: 100.0,
+        latency_seed: 1,
+        latency_min_ms: 5.0,
+        latency_max_ms: 10.0,
+        priority_upload: priority,
+        advertise_to_all: false,
+        log_path: None,
+        time_scale: 1.0,
+    }
+}
+
+/// A connected pair: (raw client socket, server side wrapped in a ShapedStream).
+async fn pair() -> (TcpStream, ShapedStream) {
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let client = TcpStream::connect(addr).await.expect("connect");
+    let (server, peer) = listener.accept().await.expect("accept");
+    (client, wrap(server, peer))
+}
+
+fn open_fds() -> usize {
+    std::fs::read_dir("/proc/self/fd").map(|d| d.count()).unwrap_or(0)
+}
+
+fn pseudo_random(len: usize, seed: u64) -> Vec<u8> {
+    let mut z = seed;
+    (0..len)
+        .map(|_| {
+            z = z.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
+            (z >> 33) as u8
+        })
+        .collect()
+}
+
+/// Bytes written in odd-sized pieces arrive intact and in order, in both directions.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn stream_integrity_without_install() {
+    let (mut client, mut server) = pair().await;
+    let data = pseudo_random(3 * 1024 * 1024 + 17, 7);
+    let send = data.clone();
+    let writer = tokio::spawn(async move {
+        let mut off = 0;
+        let mut step = 1;
+        while off < send.len() {
+            let end = (off + step).min(send.len());
+            client.write_all(&send[off..end]).await.expect("write");
+            off = end;
+            step = (step * 7 + 3) % 70_001 + 1;
+        }
+        client.shutdown().await.expect("shutdown");
+        client
+    });
+    let mut got = Vec::new();
+    server.read_to_end(&mut got).await.expect("read");
+    assert_eq!(got.len(), data.len());
+    assert!(got == data, "stream corrupted");
+
+    // and the other direction, through the shaped writer
+    let mut client = writer.await.expect("join");
+    let back = pseudo_random(2 * 1024 * 1024 + 5, 9);
+    server.write_all(&back).await.expect("write back");
+    server.shutdown().await.expect("shutdown back");
+    let mut got = Vec::new();
+    client.read_to_end(&mut got).await.expect("read back");
+    assert!(got == back, "reverse stream corrupted");
+}
+
+/// With the testbed installed, data still arrives intact through shaping and latency.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn stream_integrity_with_install() {
+    install(cfg(false));
+    let (mut client, mut server) = pair().await;
+    let data = pseudo_random(2 * 1024 * 1024, 11);
+    let send = data.clone();
+    tokio::spawn(async move {
+        client.write_all(&send).await.expect("write");
+        client.shutdown().await.expect("shutdown");
+        // keep the socket open until the reader finishes
+        tokio::time::sleep(Duration::from_secs(5)).await;
+    });
+    let start = Instant::now();
+    let mut got = Vec::new();
+    server.read_to_end(&mut got).await.expect("read");
+    assert!(got == data, "stream corrupted under shaping");
+    // 2 MiB at 100 Mb/s download takes about 168 ms
+    let took = start.elapsed();
+    assert!(took >= Duration::from_millis(140), "download not shaped: {took:?}");
+}
