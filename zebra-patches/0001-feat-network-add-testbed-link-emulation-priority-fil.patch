+/// FINDING: any large inbound burst counts as throughput, so a peer can raise its own
+/// priority by sending unsolicited bulk data.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn unsolicited_bulk_data_raises_priority() {
+    install(cfg(true));
+    let (mut client, mut server) = pair().await;
+    let peer_ip = IpAddr::V4(Ipv4Addr::LOCALHOST);
+    assert!(TESTBED.get().expect("installed").peer_rates.lock().expect("lock").get(&peer_ip).is_none());
+    let drain = tokio::spawn(async move {
+        let mut buf = vec![0u8; 65536];
+        while let Ok(n) = server.read(&mut buf).await {
+            if n == 0 {
