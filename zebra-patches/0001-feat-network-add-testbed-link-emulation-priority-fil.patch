+/// FINDING: dropping a ShapedStream does not close its socket while the peer stays silent,
+/// because the detached reader task still owns the read half.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn dropped_stream_leaks_socket_while_peer_is_silent() {
+    let before = open_fds();
+    let mut clients = Vec::new();
+    for _ in 0..50 {
+        let (client, server) = pair().await;
+        drop(server); // what Zebra does when it disconnects or bans a peer
+        clients.push(client); // the "attacker" keeps its end open and never sends
+    }
+    tokio::time::sleep(Duration::from_millis(500)).await;
+    let after = open_fds();
+    // 50 client sockets are expected; anything above that is a leaked server socket.
+    let leaked = after.saturating_sub(before).saturating_sub(50);
+    println!("fds before {before}, after {after}, leaked server sockets: {leaked}");
+    assert!(leaked >= 45, "expected the leak to reproduce, got {leaked}");
+
+    // control: plain TcpStream closes immediately
+    let before = open_fds();
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
+    let addr = listener.local_addr().expect("addr");
+    let mut plain_clients = Vec::new();
+    for _ in 0..50 {
+        let c = TcpStream::connect(addr).await.expect("connect");
+        let (s, _) = listener.accept().await.expect("accept");
+        drop(s);
+        plain_clients.push(c);
+    }
+    tokio::time::sleep(Duration::from_millis(200)).await;
+    let leaked_plain = open_fds().saturating_sub(before).saturating_sub(51);
+    println!("plain TcpStream leaked: {leaked_plain}");
+    assert_eq!(leaked_plain, 0);
+}
