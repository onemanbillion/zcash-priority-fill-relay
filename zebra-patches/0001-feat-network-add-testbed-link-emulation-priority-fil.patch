diff --git a/zebra-network/src/testbed.rs b/zebra-network/src/testbed.rs
new file mode 100644
index 0000000..b15e401
--- /dev/null
+++ b/zebra-network/src/testbed.rs
@@ -0,0 +1,594 @@
+//! Testbed-only instrumentation for block relay experiments. Not for production use.
+//!
+//! When [`install`] is called, every peer TCP connection is wrapped in a [`ShapedStream`]:
+//! - this node's total upload and download are limited by shared token buckets,
+//! - incoming bytes are delayed by a deterministic per-link one-way latency,
+//! - kernel socket buffers are kept small so slow receivers apply backpressure.
+//!
+//! It also provides the experimental "priority fill" upload scheduler for block responses,
+//! and the block advert fanout switch (one third of peers, like Mainnet, or all peers).
+
+use std::{
+    collections::{HashMap, VecDeque},
+    future::Future,
+    io::{self, Write},
+    net::{IpAddr, SocketAddr},
+    pin::Pin,
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        Arc, Mutex, OnceLock,
+    },
+    task::{Context, Poll},
+    time::Duration,
+};
+
+use bytes::Bytes;
+use tokio::{
+    io::{AsyncRead, AsyncReadExt, AsyncWrite, ReadBuf},
+    net::{
+        tcp::{OwnedReadHalf, OwnedWriteHalf},
+        TcpSocket, TcpStream,
+    },
+    sync::{mpsc, oneshot},
+    time::{Instant, Sleep},
+};
+
+/// Maximum bytes moved per read or write call.
+const CHUNK: usize = 16 * 1024;
+/// Kernel socket buffer size, small so backpressure reaches the sender quickly.
+const SOCK_BUF: usize = 32 * 1024;
+/// Bytes of a contiguous receive burst needed before it counts as a throughput sample.
+const MIN_SAMPLE_BYTES: u64 = 256 * 1024;
+/// A pause longer than this ends a receive burst.
+const BURST_GAP: Duration = Duration::from_millis(150);
+/// Upload utilization below this fraction lets the scheduler admit another transfer.
+const ADMIT_UTILIZATION: f64 = 0.85;
+/// Minimum time between admissions while other transfers are active.
+const RAMP: Duration = Duration::from_millis(50);
+/// Window used to measure upload utilization.
+const UTIL_WINDOW: Duration = Duration::from_millis(100);
+
+/// Testbed settings for this node.
+#[derive(Clone, Debug)]
+pub struct TestbedConfig {
+    /// This node's IP address. Outbound connections bind to it.
+    pub own_ip: IpAddr,
+    /// Upload capacity, megabits per second.
+    pub upload_mbps: f64,
+    /// Download capacity, megabits per second.
+    pub download_mbps: f64,
+    /// Seed for per-link latencies (all nodes must use the same seed).
+    pub latency_seed: u64,
+    /// Minimum one-way link latency, milliseconds.
+    pub latency_min_ms: f64,
+    /// Maximum one-way link latency, milliseconds.
+    pub latency_max_ms: f64,
+    /// Use the priority-fill upload scheduler for block responses.
+    pub priority_upload: bool,
+    /// Advertise relayed blocks to every peer, rather than one third of them (Mainnet behaviour).
+    pub advertise_to_all: bool,
+    /// Optional event log file.
+    pub log_path: Option<String>,
+    /// Time dilation factor applied to the scheduler's internal timings.
+    pub time_scale: f64,
+}
+
+struct Testbed {
+    cfg: TestbedConfig,
+    up: Arc<Bucket>,
+    down: Arc<Bucket>,
+    peer_rates: Mutex<HashMap<IpAddr, f64>>,
+    gate: Mutex<GateInner>,
+    log: Option<Mutex<std::fs::File>>,
+}
+
+static TESTBED: OnceLock<Testbed> = OnceLock::new();
+
+fn scaled(d: Duration) -> Duration {
+    TESTBED
+        .get()
+        .map(|tb| d.mul_f64(tb.cfg.time_scale))
+        .unwrap_or(d)
+}
+
+/// Installs the testbed. Must be called inside a Tokio runtime, before `zebra_network::init`.
+pub fn install(cfg: TestbedConfig) {
+    let log = cfg.log_path.as_ref().map(|p| {
+        Mutex::new(
+            std::fs::OpenOptions::new()
+                .create(true)
+                .append(true)
+                .open(p)
+                .expect("testbed log path is writable"),
+        )
+    });
+    let tb = Testbed {
+        up: Arc::new(Bucket::new(cfg.upload_mbps * 1e6 / 8.0)),
+        down: Arc::new(Bucket::new(cfg.download_mbps * 1e6 / 8.0)),
+        peer_rates: Mutex::new(HashMap::new()),
+        gate: Mutex::new(GateInner::default()),
+        log,
+        cfg,
+    };
+    if TESTBED.set(tb).is_err() {
+        panic!("testbed installed twice");
+    }
+    if !TESTBED.get().expect("just set").cfg.priority_upload {
+        return;
+    }
+    tokio::spawn(async {
+        let mut tick = tokio::time::interval(scaled(Duration::from_millis(10)));
+        loop {
+            tick.tick().await;
+            if let Some(tb) = TESTBED.get() {
+                tb.pump();
+            }
+        }
+    });
+}
+
+/// Writes one line to the testbed event log.
+pub fn log_event(line: &str) {
+    if let Some(tb) = TESTBED.get() {
+        if let Some(log) = &tb.log {
+            let ms = std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_micros())
+                .unwrap_or_default();
+            let mut f = log.lock().expect("log lock is not poisoned");
+            let _ = writeln!(f, "{} {}", ms, line);
+        }
+    }
+}
+
+/// Returns this node's current throughput estimates for its peers, in megabits per second.
+pub fn peer_rate_estimates() -> Vec<(IpAddr, f64)> {
+    TESTBED
+        .get()
+        .map(|tb| {
+            tb.peer_rates
+                .lock()
+                .expect("lock is not poisoned")
+                .iter()
+                .map(|(ip, r)| (*ip, r * 8.0 / 1e6))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// Seeds this node's throughput estimate for a peer, in megabits per second
+/// (for experiments that start from a long-running node's state).
+pub fn seed_peer_rate(peer: IpAddr, mbps: f64) {
+    if let Some(tb) = TESTBED.get() {
+        tb.peer_rates
+            .lock()
+            .expect("lock is not poisoned")
+            .insert(peer, mbps * 1e6 / 8.0);
+    }
+}
+
+/// How many of `peers` connected peers a relayed block advert goes to.
+pub(crate) fn broadcast_peer_count(peers: usize, default: usize) -> usize {
+    match TESTBED.get() {
+        Some(tb) if tb.cfg.advertise_to_all => peers,
+        Some(_) => peers.div_ceil(3),
+        None => default,
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Token buckets
+
+struct Bucket {
+    rate: f64,
+    burst: f64,
+    state: Mutex<(f64, Instant)>,
+    total: AtomicU64,
+}
+
+impl Bucket {
+    fn new(rate: f64) -> Self {
+        let burst = (rate * 0.005).max(32.0 * 1024.0);
+        Bucket {
+            rate,
+            burst,
+            state: Mutex::new((burst, Instant::now())),
+            total: AtomicU64::new(0),
+        }
+    }
+
+    fn unlimited() -> Self {
+        Self::new(f64::INFINITY)
+    }
+
+    fn refill(&self, st: &mut (f64, Instant)) {
+        if !self.rate.is_finite() {
+            st.0 = 0.0;
+            return;
+        }
+        let now = Instant::now();
+        let dt = now.saturating_duration_since(st.1).as_secs_f64();
+        st.0 = (st.0 + dt * self.rate).min(self.burst);
+        st.1 = now;
+    }
+
+    /// How long to wait before sending more, if the bucket is in debt.
+    fn wait(&self) -> Option<Duration> {
+        let mut st = self.state.lock().expect("lock is not poisoned");
+        self.refill(&mut st);
+        if st.0 >= 0.0 {
+            None
+        } else {
+            Some(Duration::from_secs_f64(-st.0 / self.rate).max(Duration::from_millis(1)))
+        }
+    }
+
+    fn consume(&self, n: usize) {
+        let mut st = self.state.lock().expect("lock is not poisoned");
+        self.refill(&mut st);
+        if self.rate.is_finite() {
+            st.0 -= n as f64;
+        }
+        self.total.fetch_add(n as u64, Ordering::Relaxed);
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Shaped streams
+
+/// A peer connection with emulated bandwidth and latency.
+pub struct ShapedStream {
+    write: OwnedWriteHalf,
+    rx: mpsc::Receiver<(Instant, Bytes)>,
+    pending: Option<(Instant, Bytes)>,
+    read_sleep: Option<Pin<Box<Sleep>>>,
+    write_sleep: Option<Pin<Box<Sleep>>>,
+    up: Arc<Bucket>,
+}
+
+fn link_latency(a: IpAddr, b: IpAddr) -> Duration {
+    let Some(tb) = TESTBED.get() else {
+        return Duration::ZERO;
+    };
+    let key = |ip: IpAddr| match ip {
+        IpAddr::V4(v4) => u32::from(v4) as u64,
+        IpAddr::V6(v6) => u128::from(v6) as u64,
+    };
+    let (x, y) = (key(a).min(key(b)), key(a).max(key(b)));
+    // splitmix64
+    let mut z = tb.cfg.latency_seed ^ (x << 32) ^ y;
+    z = z.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^= z >> 31;
+    let u = (z >> 11) as f64 / (1u64 << 53) as f64;
+    let ms = tb.cfg.latency_min_ms + u * (tb.cfg.latency_max_ms - tb.cfg.latency_min_ms);
+    Duration::from_secs_f64(ms / 1000.0)
+}
+
+/// Opens an outbound connection, bound to this node's testbed IP when installed.
+pub(crate) async fn connect(addr: SocketAddr) -> io::Result<TcpStream> {
+    let Some(tb) = TESTBED.get() else {
+        return TcpStream::connect(addr).await;
+    };
+    // Testbed nodes start together, so a peer's listener may not be open yet: retry refusals
+    // briefly instead of waiting minutes for Zebra's reconnection delay.
+    let deadline = Instant::now() + Duration::from_millis(2500);
+    loop {
+        let sock = if addr.is_ipv4() {
+            TcpSocket::new_v4()?
+        } else {
+            TcpSocket::new_v6()?
+        };
+        sock.bind(SocketAddr::new(tb.cfg.own_ip, 0))?;
+        sock.set_send_buffer_size(SOCK_BUF as u32)?;
+        sock.set_recv_buffer_size(SOCK_BUF as u32)?;
+        match sock.connect(addr).await {
+            Err(e) if e.kind() == io::ErrorKind::ConnectionRefused && Instant::now() < deadline => {
+                tokio::time::sleep(Duration::from_millis(100)).await;
+            }
+            other => return other,
+        }
+    }
+}
+
+/// Wraps a connected peer stream in the testbed link emulation.
+pub(crate) fn wrap(stream: TcpStream, peer: SocketAddr) -> ShapedStream {
+    let (up, down, lat) = match TESTBED.get() {
+        Some(tb) => {
+            let sref = socket2::SockRef::from(&stream);
+            let _ = sref.set_send_buffer_size(SOCK_BUF);
+            let _ = sref.set_recv_buffer_size(SOCK_BUF);
+            (tb.up.clone(), tb.down.clone(), link_latency(tb.cfg.own_ip, peer.ip()))
+        }
+        None => (Arc::new(Bucket::unlimited()), Arc::new(Bucket::unlimited()), Duration::ZERO),
+    };
+    let _ = stream.set_nodelay(true);
+    let (read, write) = stream.into_split();
+    let (tx, rx) = mpsc::channel(256);
+    tokio::spawn(reader(read, tx, down, lat, peer.ip()));
+    ShapedStream {
+        write,
+        rx,
+        pending: None,
+        read_sleep: None,
+        write_sleep: None,
+        up,
+    }
+}
+
+async fn reader(
+    mut read: OwnedReadHalf,
+    tx: mpsc::Sender<(Instant, Bytes)>,
+    down: Arc<Bucket>,
+    lat: Duration,
+    peer: IpAddr,
+) {
+    let mut buf = vec![0u8; CHUNK];
+    let mut burst: Option<(Instant, Instant, u64, usize)> = None; // start, last, bytes, first chunk
+    loop {
+        while let Some(d) = down.wait() {
+            tokio::time::sleep(d).await;
+        }
+        let n = match read.read(&mut buf).await {
+            Ok(0) | Err(_) => break,
+            Ok(n) => n,
+        };
+        down.consume(n);
+        let now = Instant::now();
+        match &mut burst {
+            Some((_, last, bytes, _)) if now.saturating_duration_since(*last) <= scaled(BURST_GAP) => {
+                *bytes += n as u64;
+                *last = now;
+            }
+            _ => {
+                if let Some(b) = burst.take() {
+                    record_burst(peer, b);
+                }
+                burst = Some((now, now, n as u64, n));
+            }
+        }
+        if tx
+            .send((now + lat, Bytes::copy_from_slice(&buf[..n])))
+            .await
+            .is_err()
+        {
+            break;
+        }
+    }
+    if let Some(b) = burst.take() {
+        record_burst(peer, b);
+    }
+}
+
+fn record_burst(peer: IpAddr, (start, last, bytes, first): (Instant, Instant, u64, usize)) {
+    let dur = last.saturating_duration_since(start).as_secs_f64();
+    if bytes < MIN_SAMPLE_BYTES || dur <= 0.0 {
+        return;
+    }
+    let rate = (bytes - first as u64) as f64 / dur;
+    if let Some(tb) = TESTBED.get() {
+        let mut rates = tb.peer_rates.lock().expect("lock is not poisoned");
+        let e = rates.entry(peer).or_insert(rate);
+        *e = 0.5 * *e + 0.5 * rate;
+        drop(rates);
+        log_event(&format!("RATE {} {:.1}", peer, rate * 8.0 / 1e6));
+    }
+}
+
+impl AsyncRead for ShapedStream {
+    fn poll_read(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        out: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        let this = &mut *self;
+        if this.pending.is_none() {
+            match this.rx.poll_recv(cx) {
+                Poll::Ready(Some(item)) => this.pending = Some(item),
+                Poll::Ready(None) => return Poll::Ready(Ok(())),
+                Poll::Pending => return Poll::Pending,
+            }
+        }
+        let due = this.pending.as_ref().expect("just set").0;
+        if Instant::now() < due {
+            let sleep = this
+                .read_sleep
+                .get_or_insert_with(|| Box::pin(tokio::time::sleep_until(due)));
+            if sleep.deadline() != due {
+                sleep.as_mut().reset(due);
+            }
+            if sleep.as_mut().poll(cx).is_pending() {
+                return Poll::Pending;
+            }
+        }
+        this.read_sleep = None;
+        let (_, bytes) = this.pending.as_mut().expect("just set");
+        let n = out.remaining().min(bytes.len());
+        out.put_slice(&bytes.split_to(n));
+        if bytes.is_empty() {
+            this.pending = None;
+        }
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncWrite for ShapedStream {
+    fn poll_write(
+        mut self: Pin<&mut Self>,
+        cx: &mut Context<'_>,
+        buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        let this = &mut *self;
+        loop {
+            if let Some(sleep) = this.write_sleep.as_mut() {
+                futures::ready!(sleep.as_mut().poll(cx));
+                this.write_sleep = None;
+            }
+            match this.up.wait() {
+                Some(d) => this.write_sleep = Some(Box::pin(tokio::time::sleep(d))),
+                None => break,
+            }
+        }
+        let n = buf.len().min(CHUNK);
+        match Pin::new(&mut this.write).poll_write(cx, &buf[..n]) {
+            Poll::Ready(Ok(w)) => {
+                this.up.consume(w);
+                Poll::Ready(Ok(w))
+            }
+            other => other,
+        }
+    }
+
+    fn poll_flush(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.write).poll_flush(cx)
+    }
+
+    fn poll_shutdown(mut self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Pin::new(&mut self.write).poll_shutdown(cx)
+    }
+}
+
+// ---------------------------------------------------------------------------------------------
+// Priority-fill upload scheduler
+
+#[derive(Default)]
+struct GateInner {
+    active: usize,
+    waiting: Vec<(f64, u64, oneshot::Sender<()>)>,
+    next_id: u64,
+    last_admit: Option<Instant>,
+    samples: VecDeque<(Instant, u64)>,
+}
+
+impl Testbed {
+    fn rate_estimate(&self, peer: Option<IpAddr>) -> f64 {
+        let rates = self.peer_rates.lock().expect("lock is not poisoned");
+        if let Some(r) = peer.and_then(|p| rates.get(&p)) {
+            return *r;
+        }
+        if rates.is_empty() {
+            return 50e6 / 8.0;
+        }
+        let mut v: Vec<f64> = rates.values().copied().collect();
+        v.sort_by(|a, b| a.partial_cmp(b).expect("rates are finite"));
+        v[v.len() / 2]
+    }
+
+    fn utilization(&self, g: &GateInner) -> f64 {
+        let (Some(first), Some(last)) = (g.samples.front(), g.samples.back()) else {
+            return 1.0;
+        };
+        let dt = last.0.saturating_duration_since(first.0).as_secs_f64();
+        if dt < scaled(UTIL_WINDOW).as_secs_f64() * 0.5 {
+            return 1.0;
+        }
+        (last.1 - first.1) as f64 / (self.up.rate * dt)
+    }
+
+    /// Samples upload utilization and admits waiting transfers if there is spare capacity.
+    fn pump(&self) {
+        let now = Instant::now();
+        let mut g = self.gate.lock().expect("lock is not poisoned");
+        g.samples
+            .push_back((now, self.up.total.load(Ordering::Relaxed)));
+        while g
+            .samples
+            .front()
+            .is_some_and(|(t, _)| now.saturating_duration_since(*t) > scaled(UTIL_WINDOW))
+        {
+            g.samples.pop_front();
+        }
+        self.admit(&mut g, now);
+    }
+
+    fn admit(&self, g: &mut GateInner, now: Instant) {
+        loop {
+            if g.waiting.is_empty() {
+                return;
+            }
+            let spare = g.active == 0
+                || (g
+                    .last_admit
+                    .is_none_or(|t| now.saturating_duration_since(t) >= scaled(RAMP))
+                    && self.utilization(g) < ADMIT_UTILIZATION);
+            if !spare {
+                return;
+            }
+            // Highest estimated relay rate first, then earliest request.
+            let best = g
+                .waiting
+                .iter()
+                .enumerate()
+                .max_by(|(_, a), (_, b)| {
+                    a.0.partial_cmp(&b.0)
+                        .expect("rates are finite")
+                        .then(b.1.cmp(&a.1))
+                })
+                .map(|(i, _)| i)
+                .expect("waiting is not empty");
+            let (_, _, tx) = g.waiting.swap_remove(best);
+            if tx.send(()).is_ok() {
+                g.active += 1;
+                g.last_admit = Some(now);
+                if g.active > 1 {
+                    return;
+                }
+            }
+        }
+    }
+}
+
+/// Held while a block response is being written to a peer.
+pub(crate) struct ServeGuard {
+    peer: Option<IpAddr>,
+    gated: bool,
+}
+
+impl Drop for ServeGuard {
+    fn drop(&mut self) {
+        let Some(tb) = TESTBED.get() else { return };
+        log_event(&format!(
+            "SERVE_END {}",
+            self.peer.map(|p| p.to_string()).unwrap_or_default()
+        ));
+        if self.gated {
+            let mut g = tb.gate.lock().expect("lock is not poisoned");
+            g.active = g.active.saturating_sub(1);
+            tb.admit(&mut g, Instant::now());
+        }
+    }
+}
+
+/// Waits until this node's upload scheduler lets a block response to `peer` start.
+pub(crate) async fn serve_blocks(peer: Option<IpAddr>) -> Option<ServeGuard> {
+    let tb = TESTBED.get()?;
+    let peer_label = peer.map(|p| p.to_string()).unwrap_or_default();
+    if !tb.cfg.priority_upload {
+        log_event(&format!("SERVE_START {} 0", peer_label));
+        return Some(ServeGuard { peer, gated: false });
+    }
+    let est = tb.rate_estimate(peer);
+    let (tx, rx) = oneshot::channel();
+    {
+        let mut g = tb.gate.lock().expect("lock is not poisoned");
+        let id = g.next_id;
+        g.next_id += 1;
+        g.waiting.push((est, id, tx));
+        tb.admit(&mut g, Instant::now());
+    }
+    let queued = Instant::now();
+    if rx.await.is_err() {
+        return None;
+    }
+    log_event(&format!(
+        "SERVE_START {} {:.0} est={:.1}",
+        peer_label,
+        queued.elapsed().as_secs_f64() * 1000.0,
+        est * 8.0 / 1e6
+    ));
+    Some(ServeGuard { peer, gated: true })
+}
