+/// A peer that is ranked high but reads a block response slowly is demoted: its rank is capped
+/// at the rate it actually read at, and a later normal response lifts the cap.
+#[tokio::test(flavor = "current_thread")]
+async fn slow_reader_is_demoted() {
+    install(cfg(true));
+    let (liar, honest) = (ip("10.0.1.1"), ip("10.0.1.2"));
+    seed_peer_rate(liar, 400.0).expect("valid");
+    seed_peer_rate(honest, 100.0).expect("valid");
+    let tb = TESTBED.get().expect("installed");
+    let mbps = |p| tb.rate_estimate(Some(p)) * 8.0 / 1e6;
+
+    // 2 MB that takes 1.6 s is 10 Mb/s, far below the 400 Mb/s estimate.
+    let g = serve_blocks(Some(liar), vec![hash(1)], 2_000_000)
+        .await
+        .expect("admitted");
+    tokio::time::sleep(Duration::from_millis(1600)).await;
+    drop(g);
+    let demoted = mbps(liar);
+    println!("liar estimate after a slow read: {demoted:.1} Mb/s");
+    assert!(
+        demoted < 20.0,
+        "slow reader should be demoted, estimate {demoted}"
+    );
+    assert!(
+        demoted < mbps(honest),
+        "demoted peer should rank below an honest one"
+    );
+
+    // An honest, quick response does not demote.
+    let g = serve_blocks(Some(honest), vec![hash(2)], 2_000_000)
+        .await
+        .expect("admitted");
+    tokio::time::sleep(Duration::from_millis(50)).await;
+    drop(g);
+    assert!(
+        (mbps(honest) - 100.0).abs() < 1.0,
+        "honest peer keeps its estimate"
+    );
+
+    // Reading normally again lifts the demotion.
+    let g = serve_blocks(Some(liar), vec![hash(3)], 2_000_000)
+        .await
+        .expect("admitted");
+    tokio::time::sleep(Duration::from_millis(40)).await;
+    drop(g);
+    assert!(
+        mbps(liar) > 300.0,
+        "demotion should lift after a normal read"
+    );
+}
