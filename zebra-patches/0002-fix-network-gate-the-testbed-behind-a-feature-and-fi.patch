index 0000000..7d24849
--- /dev/null
+++ b/zebra-network/src/peer_stream.rs
@@ -0,0 +1,52 @@
+//! The transport used for peer connections.
+//!
+//! Normal builds use plain TCP. Builds with the `testbed` feature wrap each connection in the
+//! testbed's link emulation.
+
+use std::{io, net::SocketAddr, time::Duration};
+
+use tokio::net::TcpStream;
+
+/// The transport type of a peer connection.
+#[cfg(not(feature = "testbed"))]
+pub(crate) type PeerStream = TcpStream;
+
+/// The transport type of a peer connection.
+#[cfg(feature = "testbed")]
+pub(crate) type PeerStream = crate::testbed::ShapedStream;
+
+/// Opens an outbound peer connection to `addr`.
+pub(crate) async fn connect(addr: SocketAddr) -> io::Result<PeerStream> {
+    #[cfg(not(feature = "testbed"))]
+    return TcpStream::connect(addr).await;
+
+    #[cfg(feature = "testbed")]
+    {
+        let stream = crate::testbed::connect(addr).await?;
+        Ok(crate::testbed::wrap(stream, addr))
+    }
+}
+
+/// Turns an accepted inbound socket from `addr` into a peer transport.
+pub(crate) fn accept(stream: TcpStream, addr: SocketAddr) -> PeerStream {
+    #[cfg(not(feature = "testbed"))]
+    {
+        let _ = addr;
+        stream
+    }
+
+    #[cfg(feature = "testbed")]
+    crate::testbed::wrap(stream, addr)
+}
+
+/// The minimum interval between accepted inbound connections.
+///
+/// Testbed builds shorten it while the testbed is installed, so that many local nodes can
+/// connect to each other at startup. Overload protection keeps using the normal constant.
+pub(crate) fn inbound_connection_interval(default: Duration) -> Duration {
+    #[cfg(feature = "testbed")]
+    return crate::testbed::inbound_connection_interval(default);
+
+    #[cfg(not(feature = "testbed"))]
+    default
+}
