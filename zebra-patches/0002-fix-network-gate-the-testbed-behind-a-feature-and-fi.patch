+        tasks.push(tokio::spawn(async move {
+            let g = serve_blocks(Some(p), vec![hash(7)])
+                .await
+                .expect("admitted");
+            order.lock().expect("lock").push(p);
+            drop(g);
+        }));
+    }
+    tokio::task::yield_now().await;
+    TESTBED
+        .get()
+        .expect("installed")
+        .up
+        .total
+        .fetch_add(1 << 40, Ordering::Relaxed);
+    drop(holder);
+    for t in tasks {
+        t.await.expect("join");
+    }
+    let order = order.lock().expect("lock").clone();
+    assert_eq!(
+        order.first(),
+        Some(&slow),
+        "repeat should go last: {order:?}"
+    );
+}
+
+/// Fixed finding 11: the estimate map stays bounded.
+#[tokio::test(flavor = "current_thread")]
+async fn estimate_map_is_bounded() {
+    install(cfg(true));
+    for i in 0..(MAX_ESTIMATES + 100) {
+        // `usize` to `u32` cannot truncate for this loop's range.
+        let a = Ipv4Addr::from(0x0A00_0000u32 + i as u32);
+        seed_peer_rate(IpAddr::V4(a), 10.0).expect("valid");
+    }
+    let n = peer_rate_estimates().len();
+    println!("estimates stored: {n}");
+    assert!(n <= MAX_ESTIMATES);
 }
