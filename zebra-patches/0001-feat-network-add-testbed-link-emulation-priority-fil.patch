+/// The scheduler serves the highest-estimate waiting peer first.
+#[tokio::test(flavor = "current_thread")]
+async fn gate_admits_highest_estimate_first() {
+    install(cfg(true));
+    let slow: IpAddr = "10.0.0.1".parse().expect("ip");
+    let fast: IpAddr = "10.0.0.2".parse().expect("ip");
+    let mid: IpAddr = "10.0.0.3".parse().expect("ip");
+    seed_peer_rate(slow, 5.0);
+    seed_peer_rate(fast, 500.0);
+    seed_peer_rate(mid, 50.0);
+
+    // Occupy the uplink so the others must queue.
+    let first = serve_blocks(Some(slow)).await.expect("first admitted at once");
+    let order = Arc::new(Mutex::new(Vec::new()));
+    let mut tasks = Vec::new();
+    for ip in [mid, fast] {
+        let order = order.clone();
+        tasks.push(tokio::spawn(async move {
+            let g = serve_blocks(Some(ip)).await.expect("admitted");
+            order.lock().expect("lock").push(ip);
+            tokio::time::sleep(Duration::from_millis(5)).await;
+            drop(g);
+        }));
+    }
+    tokio::task::yield_now().await;
+    // Fake full utilization so nothing else is admitted while `first` is active.
+    TESTBED.get().expect("installed").up.total.fetch_add(1 << 40, Ordering::Relaxed);
+    drop(first);
+    for t in tasks {
+        t.await.expect("join");
+    }
+    let order = order.lock().expect("lock").clone();
+    assert_eq!(order.first(), Some(&fast), "fast peer should be served first: {order:?}");
+}
+
+/// FINDING: a request cancelled after it was admitted, but before it ran, leaks a slot.
+#[tokio::test(flavor = "current_thread")]
+async fn cancelled_admission_leaks_an_active_slot() {
+    install(cfg(true));
+    let a: IpAddr = "10.0.0.1".parse().expect("ip");
+    let b: IpAddr = "10.0.0.2".parse().expect("ip");
+    let first = serve_blocks(Some(a)).await.expect("admitted");
+    let waiter = tokio::spawn(serve_blocks(Some(b)));
+    tokio::task::yield_now().await; // waiter is now queued
+    drop(first); // admits the waiter: its oneshot fires
+    waiter.abort(); // the connection is torn down before the task runs again
+    let _ = waiter.await;
+    let active = TESTBED.get().expect("installed").gate.lock().expect("lock").active;
+    println!("active slots with no transfer running: {active}");
+    assert_eq!(active, 1, "expected the leaked slot to reproduce");
+}
